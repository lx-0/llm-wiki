{
  "name": "desktop",
  "productName": "desktop",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".vite/build/main.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "dmg": "electron-forge make --targets @electron-forge/maker-dmg",
    "reinstall": "bash scripts/dev-install.sh",
    "build:renderer": "vite build -c vite.renderer.config.ts",
    "shots": "npm run build:renderer && electron scripts/shots/capture.cjs"
  },
  "keywords": [],
  "author": {
    "name": "Alex Wegener",
    "email": "github.com@m.9aw.de"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "electron": "42.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "marked": "^18.0.5"
  }
}
