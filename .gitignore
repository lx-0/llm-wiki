# Per-instance config — only config.example.yaml is tracked
config.yaml
.env
.env.*
!.env*.example

# Runtime artifacts — per-instance, never tracked.
# (Inline `# comments` on these lines do NOT work — gitignore only treats `#`
#  as a comment when it starts the line. Keep paths on their own lines.)
# state/    — *.json hash trackers, dedup, cooldowns
# logs/     — *.log files
# sessions/ — session-flush-*.md / flush-context-*.md staging + failed-flushes/
state/
logs/
sessions/

# Legacy locations (M001/S02 lifted runtime dirs from scripts/{state,logs,sessions}/
# up to the engine root; old installs may still have these on disk during the
# migration window). Drop after a release where every install has updated.
scripts/state/
scripts/logs/
scripts/sessions/
scripts/state.json
scripts/last-flush.json
scripts/email-state.json
scripts/screenshot-state.json
scripts/piggyback-state.json
scripts/*.log
scripts/failed-flushes/
scripts/session-flush-*.md
scripts/flush-context-*.md

# Reports
reports/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.uv-cache/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Agents local user settings
.claude/settings.local.json

# ytstack runtime artifacts (per-install session journal — never tracked)
.ytstack/journal/
.ytstack/HANDOFF.md

# TMP
~*.md
~*/