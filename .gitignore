# Per-instance config — only config.example.yaml is tracked
config.yaml
.env
.env.*
!.env*.example

# Runtime artifacts — per-instance, never tracked.
# (Inline `# comments` on these lines do NOT work — gitignore only treats `#`
#  as a comment when it starts the line. Keep paths on their own lines.)
# state/    — *.json hash trackers, dedup, cooldowns
# logs/     — *.log files
# sessions/ — session-flush-*.md / flush-context-*.md staging + failed-flushes/
state/
logs/
sessions/
# custom/  — operator config overlays (deltas merged onto seeded templates;
#            see lib/seed.sh _seed_json_overlay). Per-instance + operator-owned,
#            so never part of the engine checkout.
custom/
# Round-robin config backups (every `wiki config set` snapshots the prior
# state into state/config-backups/, last 10 kept). state/ already covers
# this — listed explicitly for grep-ability.
state/config-backups/

# Legacy locations (M001/S02 lifted runtime dirs from scripts/{state,logs,sessions}/
# up to the engine root; old installs may still have these on disk during the
# migration window). Drop after a release where every install has updated.
scripts/state/
scripts/logs/
scripts/sessions/
scripts/state.json
scripts/last-flush.json
scripts/email-state.json
scripts/screenshot-state.json
scripts/piggyback-state.json
scripts/*.log
scripts/failed-flushes/
scripts/session-flush-*.md
scripts/flush-context-*.md

# Reports (vault-root operator data only — engine code under scripts/reports/ and templates/reports/ is committed)
/reports/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.uv-cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Agents local user settings
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# ytstack runtime artifacts (per-install session journal — never tracked)
.ytstack/journal/
.ytstack/HANDOFF.md

# TMP
~*.md
~*/

# Zoom-crop review artifacts. The excalidraw renderer writes `--crop` output to
# docs/<name>-crop.png, so every diagram review (CLAUDE.md gate 3) clobbers
# them. They are throwaway, referenced by nothing, and regenerated on demand.
docs/*-crop.png