    {
      "type": "text",
      "id": "ann_compile",
      "x": 1420,
      "y": 1089.8050053435759,
      "width": 380,
      "height": 97.5,
      "text": "The magic happens here. One new source doesn't just\ncreate an article -- it enriches 10-15 existing ones.\nThe compiler sees connections between email metadata\nand calendar events that no human would notice.\nFrom tens of thousands of email subjects, it can\nreconstruct multi-year activity arcs.",
      "originalText": "The magic happens here. One new source doesn't just\ncreate an article -- it enriches 10-15 existing ones.\nThe compiler sees connections between email metadata\nand calendar events that no human would notice.\nFrom tens of thousands of email subjects, it can\nreconstruct multi-year activity arcs.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#737373",
      "backgroundColor": "transparent",
