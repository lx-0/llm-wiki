      "y": 1319.6525300377907,
      "width": 350,
      "height": 80,
      "text": "---\ntitle: \"Career Arc\"\nsources: [email-scan, calendar]\n---\nMulti-year arc: Company A -> Company B\n-> Company C -> Current Role",
      "originalText": "---\ntitle: \"Career Arc\"\nsources: [email-scan, calendar]\n---\nMulti-year arc: Company A -> Company B\n-> Company C -> Current Role",
