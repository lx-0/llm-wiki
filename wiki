help_skills() {
  cat <<EOF
${C_BOLD}wiki skills${C_RESET} — wire engine skills into Claude Code

${C_BOLD}USAGE${C_RESET}
  wiki skills install               symlink missing engine skills into .claude/skills/
  wiki skills install --global      also link global skills into ~/.claude/skills/
  wiki skills install --no-global   vault-local only (turns the global opt-in off)
  wiki skills uninstall             remove engine-owned symlinks (foreign entries kept)
  wiki skills uninstall --global    also remove this vault's global links + deregister
  wiki skills sync                  install missing + prune stale (run after wiki update)
  wiki skills status                per-skill linked / collision / missing table

${C_BOLD}NOTES${C_RESET}
  Source: $WIKI_DIR/skills/
  Target: $ROOT_DIR/.claude/skills/
  Only symlinks pointing at ../../.wiki/skills/<name> are managed.
  Foreign entries (your own skills, other tools) are never modified.

${C_BOLD}GLOBAL INSTALL${C_RESET}
  Most skills operate inside a vault and stay vault-local. A few (currently:
  use-llm-wiki) let an agent in *any* project discover and use this wiki —
  those can also be linked into ~/.claude/skills/.
  The opt-in is the ${C_BOLD}skills.global_install${C_RESET} config key; the --global /
  --no-global flags are one-shot shortcuts that write it (so it persists —
  \`wiki update\` keeps an opted-in vault globally linked). The vault root is
  recorded in ${XDG_CONFIG_HOME:-\$HOME/.config}/llm-wiki/vaults for the skill's
  discovery probe. Equivalent: wiki config set skills.global_install true.
EOF
}

cmd_skills() {
  # --global / --no-global may appear anywhere; strip them, keep the rest.
  local global_flag="" a
  local -a rest=()
  for a in "$@"; do
    case "$a" in
      --global)    global_flag=1 ;;
      --no-global) global_flag=0 ;;
      *)           rest+=("$a") ;;
    esac
  done
  case "${rest[0]:-}" in
    install|"")
      [[ "$global_flag" == "1" ]] && config_set skills.global_install true  >/dev/null
      [[ "$global_flag" == "0" ]] && config_set skills.global_install false >/dev/null
      skills_cmd_install ;;
    uninstall)
      skills_cmd_uninstall
      if [[ "$global_flag" == "1" ]]; then
        config_set skills.global_install false >/dev/null
        skills_uninstall_global
        echo
        if (( _skills_global_removed > 0 )); then
          ok "removed $_skills_global_removed global symlink(s) from $GLOBAL_SKILLS_DST"
        else
          info "no global symlinks for this vault"
        fi
        info "vault deregistered from $REGISTRY_FILE; skills.global_install set false"
      fi ;;
    sync)                     skills_cmd_sync ;;
    status)                   skills_cmd_status ;;
    -h|--help|help)           help_skills ;;
    *)                        err "unknown: wiki skills ${rest[0]}"; help_skills; exit 1 ;;
  esac
}

cmd_setup() {
  case "${1:-}" in
    -h|--help|help)           help_setup; return 0 ;;
  esac
  banner "wiki setup" "First-time setup: config wizard, then hook install."
  config_cmd_setup_wizard
  echo
  if confirm "Now install hooks into agent configs?" y; then
    hooks_cmd_install
  else
    info "Skipped hook install — run \`wiki hooks install\` later."
  fi
}

cmd_help() {
  # The full command catalog lives in scripts/cli.py — render it from there
  # (single source of truth) rather than a hand-synced comment block. Non-exec
  # so callers can append their own exit code (e.g. the unknown-command path).
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli.py" help
}

_run_script() {
  # Helper: run a script under the wiki venv. $1 = script name, rest = args.
  # Retained for the bash-native dream + dream-entity commands.
  local script="$1"; shift
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/$script" "$@"
}

_dispatch_python() {
  # Delegate a Python-backed subcommand to the table-driven dispatcher.
  # `exec` so cli.py fully owns the process (banner, run, once-locked refresh)
  # and its exit code propagates directly to the caller.
  exec uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli.py" "$@"
}

_refresh_dashboards() {
  # Refresh the vault Dashboard caches ONCE, via cli.py -> flush.py's existing
  # fcntl-locked + timeout-guarded implementation. Replaces the old unlocked
  # bash helper pair; used by the bash-native `wiki seed` (Python-backed
  # commands trigger the same refresh from inside cli.py via refresh-after).
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli.py" refresh-dashboards
}

