cmd_seed() {
  local force=0 check=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)                  force=1; shift ;;
      --check)                  check=1; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki seed${C_RESET} — re-apply engine templates to the vault root

${C_BOLD}USAGE${C_RESET}
  wiki seed                     additive: add missing files, merge community-plugins
  wiki seed --check             read-only audit: report which templates have drifted
  wiki seed --force             overwrite existing vault templates with engine versions

${C_BOLD}WHAT IT DOES${C_RESET}
  - Seeds missing files: README.md, AGENTS.md, dashboard.md, knowledge.base, .claude/.env.example
  - Seeds missing .obsidian/*.json + .obsidian/plugins/<name>/data.json
  - Merges community-plugins.json (additive — adds engine plugins, never drops yours)
  - Cache files (_dashboard-*.md) are NOT seeded — first \`wiki flush\` writes them.

${C_BOLD}DRIFT REPORTING${C_RESET}
  Default mode tags each kept-existing file as either ${C_DIM}up-to-date${C_RESET} or
  ${C_DIM}drifted from engine${C_RESET}. \`--check\` runs the same audit without writing
  anything — use it after \`wiki update\` to see what would change before
  deciding whether to \`--force\` or merge manually.

${C_BOLD}SAFETY${C_RESET}
  Default mode never overwrites your edits. Use --force only if you want to
  discard your customisations and pick up the latest engine version.
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  if (( check == 1 && force == 1 )); then
    err "--check and --force are mutually exclusive"; exit 1
  fi
  local mode
  if (( check == 1 )); then mode='audit (read-only)'
  elif (( force == 1 )); then mode='overwrite mode'
  else mode='additive mode'
  fi
  banner "wiki seed" "$mode"
  seed_vault_templates "$ROOT_DIR" "$WIKI_DIR" "$force" "$check"
  # In audit mode we don't refresh dashboards — that's a side-effect of seeding.
  if (( check == 0 )); then
    _refresh_dashboard_stats
    _refresh_dashboard_lint
  fi
}


cmd_update() {
  local sync_skills=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-skills)              sync_skills=0; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki update${C_RESET} — git pull --ff-only the .wiki/ checkout

${C_BOLD}USAGE${C_RESET}
  wiki update                   pull + sync skill symlinks
  wiki update --no-skills       pull only, skip skill sync
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  if [[ ! -d "$WIKI_DIR/.git" ]]; then
    die "Not a git checkout — wiki/ wasn't installed via install.sh. Manual update required."
  fi
  local before; before="$(git -C "$WIKI_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  info "Pulling latest into $WIKI_DIR …"
  if ! git -C "$WIKI_DIR" pull --ff-only; then
    die "git pull failed (non-fast-forward or network). Resolve manually in $WIKI_DIR."
  fi
  local after; after="$(git -C "$WIKI_DIR" rev-parse --short HEAD)"
  if [[ "$before" == "$after" ]]; then
    ok "Already up to date ($before)"
  else
    ok "Updated $before → $after"
    info "If hook payloads or config schema changed, you may want to re-run:"
    info "  wiki hooks install      ${C_DIM}# to refresh agent hook configs${C_RESET}"
  fi

  # Run config-schema migration unconditionally — idempotent, prints
  # "no change" when the vault is already on the current schema, prints
  # the rename/add/drop diff and applies it otherwise. Keeps the vault's
  # config.yaml in sync with whatever the engine pull just introduced.
  info "Migrating config.yaml to current schema (idempotent) …"
  if ! uv run --quiet --project "$WIKI_DIR" python \
        "$WIKI_DIR/scripts/migrations/migrate_config_keys.py" \
        --vault "$ROOT_DIR" --apply; then
    warn "Config migration reported errors — inspect $ROOT_DIR/.wiki/config.yaml manually."
  fi

  if (( sync_skills == 1 )); then
    skills_cmd_sync
  else
    info "skills: skipped (--no-skills)"
  fi
}

