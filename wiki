#!/usr/bin/env bash
# wiki — single entry point for the engine; a bootstrap and nothing else (M034).
#
# Every command is Python: `scripts/cli.py` dispatches from the catalogue in
# `scripts/cli_catalog.py` (help texts in `scripts/cli_help.py`), which is the single
# source of truth for `wiki help`. This file does only what has to happen before Python
# can run: find its own engine directory (through the `~/.local/bin/wiki` symlink), say
# where the engine's Python environment lives, refuse a directory that is not a vault,
# and hand over to cli.py in one hop. `tests/test_bash_budget.py` holds it to 150 lines,
# with no library beside it.

set -euo pipefail

# Resolve symlinks so `wiki` invoked via ~/.local/bin/wiki (`wiki install-shortcut`) finds
# the engine next to the real file, not next to the link. macOS has no `readlink -f`.
_resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  cd "$(dirname "$src")" && pwd
}
WIKI_DIR="$(_resolve_self)"
ROOT_DIR="$(cd "$WIKI_DIR/.." && pwd)"
export WIKI_DIR ROOT_DIR

die() {
  if [[ -t 2 ]]; then printf '\e[31m✗ %s\e[0m\n' "$*" >&2; else printf '✗ %s\n' "$*" >&2; fi
  exit 1
}

command -v uv >/dev/null 2>&1 \
  || die "uv not found (needed to sync and run the engine's Python environment). Install it and retry."

# ── Where the engine's Python environment lives ──────────────────────
# A vault in a cloud-synced folder (iCloud Drive, ~/Library/CloudStorage) must not run its
# environment from there: the sync engine evicts file contents, and the kernel SIGKILLs a
# mapped binary whose pages stop matching its signature (lxw 2026-09-17; a symlinked
# .wiki/.venv is no fix either — KNOWLEDGE has the story). So such a vault's environment is
# ~/.venvs/<vault>-wiki, exported for everything this process starts; the agent hook
# commands carry it literally (core/agents.py), because the agent spawns them, not `wiki`.
# An operator's own UV_PROJECT_ENVIRONMENT always wins; elsewhere uv's .wiki/.venv stays.
# core/health/engine.py judges vaults by the same markers: tests/test_engine_env_location.py
# holds both copies to one table of cases.
if [[ -z "${UV_PROJECT_ENVIRONMENT:-}" ]]; then
  case "$WIKI_DIR" in
    */Library/Mobile\ Documents/*|*/Library/CloudStorage/*)
      export UV_PROJECT_ENVIRONMENT="$HOME/.venvs/$(basename "$ROOT_DIR")-wiki" ;;
  esac
fi

# A path in a command some other shell runs (a hint the operator pastes) is single-quoted,
# each ' written as '\'': bare '…' broke on "Alex's Vault", no quotes on `Mobile Documents`.
# Pattern removal, not ${s//…/…}: bash 5.2's patsub_replacement reads that differently
# from the macOS bash 3.2.
shell_quote() {
  local s="$1" out=""
  while [[ "$s" == *\'* ]]; do
    out+="${s%%\'*}'\\''"
    s="${s#*\'}"
  done
  printf "'%s'" "$out$s"
}

# The `uv sync` an operator can paste. Their shell never had the export above, so the
# environment is named; a bare `uv sync` would rebuild .wiki/.venv inside a cloud vault.
sync_hint() {
  printf "UV_PROJECT_ENVIRONMENT=%s uv sync --project %s" \
    "$(shell_quote "${UV_PROJECT_ENVIRONMENT:-$WIKI_DIR/.venv}")" "$(shell_quote "$WIKI_DIR")"
}

# ── Vault guard ──────────────────────────────────────────────────────
# Outside an Obsidian vault, paths.py would take a bare engine checkout for one
# (WIKI_DIR=<repo>, ROOT_DIR=<parent>) and write logs/, state/ and config.yaml into
# the engine source tree. The marker is `.obsidian/` at ROOT_DIR.
require_vault() {
  if [[ ! -d "$ROOT_DIR/.obsidian" ]]; then
    >&2 echo "wiki: $ROOT_DIR is not an Obsidian vault (no .obsidian/ directory)."
    >&2 echo "    The engine only runs against real vaults — install it as <vault>/.wiki/"
    >&2 echo "    and invoke \`wiki\` from there."
    exit 1
  fi
}

_dispatch_python() {
  # One hop (DECISIONS 2026-10-15): `exec` the venv's Python straight into cli.py, so
  # cli.py owns the process and its exit code reaches the caller, with no `uv run` parent
  # costing ~57 ms per call. A relative UV_PROJECT_ENVIRONMENT is uv's to resolve, so it
  # stays on `uv run`.
  local venv="${UV_PROJECT_ENVIRONMENT:-$WIKI_DIR/.venv}"
  case "$venv" in
    /*) ;;
    *) exec uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli.py" "$@" ;;
  esac
  # What `uv run` did besides: sync whenever uv.lock / pyproject.toml changed (a pull
  # outside `wiki update`, a hand edit). Kept: no venv yet, or either file newer than the
  # last sync's stamp → `uv sync` first (`--inexact`, as `uv run` syncs). A failed sync
  # stops here, stamp untouched, and says so: a uv that cannot run at all (an asdf shim
  # under a foreign HOME exits 126) prints nothing of its own.
  local stamp="$venv/.wiki-synced"
  if [[ ! -x "$venv/bin/python" || "$WIKI_DIR/uv.lock" -nt "$stamp" \
        || "$WIKI_DIR/pyproject.toml" -nt "$stamp" ]]; then
    if ! uv sync --quiet --inexact --project "$WIKI_DIR"; then
      die "uv sync failed — the engine's environment is behind uv.lock. To see why, run:
  $(sync_hint)"
    fi
    touch "$stamp"
  fi
  # What `uv run` puts in the environment, measured: the venv's bin/ first on PATH and
  # VIRTUAL_ENV (its UV / UV_RUN_RECURSION_DEPTH have no reader in the engine).
  export VIRTUAL_ENV="$venv" PATH="$venv/bin:$PATH"
  exec "$venv/bin/python" "$WIKI_DIR/scripts/cli.py" "$@"
}

# ── Entry point ──────────────────────────────────────────────────────
# Every command but help, version and install-shortcut touches vault state: demand a vault.
case "${1:-}" in
  help|-h|--help|version|install-shortcut) ;;
  *) require_vault ;;
esac

# Everything goes to cli.py, bare `wiki` included: it opens the home screen when stdin and
# stdout are terminals and prints help otherwise, so CI, pipes, hooks and cron never block
# on input. An unknown command errors there. "$@" still carries the command name.
_dispatch_python "$@"
