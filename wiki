cmd_collect() {
  case "${1:-}" in
    -h|--help|help)
      help_collect
      return 0
      ;;
  esac
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli_collect.py" "$@"
}

cmd_gmail_auth() {
  local account_id="${1:-}"
  if [[ -z "$account_id" || "$account_id" == "-h" || "$account_id" == "--help" ]]; then
    cat <<EOF
${C_BOLD}wiki gmail-auth${C_RESET} — one-time OAuth bootstrap for a Gmail account

${C_BOLD}USAGE${C_RESET}
  wiki gmail-auth <account-id>

${C_BOLD}WHAT IT DOES${C_RESET}
  Reads .claude/gmail-oauth-client.json (you provide this — create
  an installed-app OAuth client at console.cloud.google.com),
  opens a local-loopback browser for consent, persists the token to
  .wiki/state/gmail-token-<id>.json. Re-running re-issues consent.

${C_BOLD}EXAMPLES${C_RESET}
  wiki gmail-auth private    # consent flow for accounts.private
EOF
    return 0
  fi
  uv run --quiet --project "$WIKI_DIR" python -c "
import sys; sys.path.insert(0, '$WIKI_DIR/scripts')
from adapters.mailbox.gmail import gmail_auth_bootstrap
ok, msg = gmail_auth_bootstrap('$account_id')
print(msg)
sys.exit(0 if ok else 1)
"
}

cmd_version() {
  if [[ -d "$WIKI_DIR/.git" ]]; then
    local rev; rev="$(git -C "$WIKI_DIR" rev-parse --short HEAD)"
    local tag; tag="$(git -C "$WIKI_DIR" describe --tags --always 2>/dev/null || echo "")"
    local origin; origin="$(git -C "$WIKI_DIR" config --get remote.origin.url 2>/dev/null || echo "")"
    printf "%-12s %s\n" "revision" "$rev"
    [[ -n "$tag" && "$tag" != "$rev" ]] && printf "%-12s %s\n" "tag" "$tag"
    [[ -n "$origin" ]] && printf "%-12s %s\n" "origin" "$origin"
  else
    warn "Not a git checkout. Cannot report version."
  fi
}

# ── Top-level interactive menu ───────────────────────────────────────
top_menu() {
  banner "wiki" "$(printf "Type %swiki help%s for the non-interactive form." "$C_DIM" "$C_RESET")"
  while :; do
    echo
    local action
    action="$(select_one "What now?" \
      "show status|run setup wizard|edit config|install hooks|uninstall hooks|update from git|exit" 1)"
    case "$action" in
      "show status")        echo; cmd_status ;;
      "run setup wizard")   echo; cmd_setup ;;
      "edit config")        echo; config_cmd_edit ;;
      "install hooks")      echo; hooks_cmd_install ;;
      "uninstall hooks")    echo; hooks_cmd_uninstall ;;
      "update from git")    echo; cmd_update ;;
      "exit")               break ;;
    esac
    echo
    pause
  done
}

# ── Entry point ──────────────────────────────────────────────────────
case "${1:-}" in
  "")               top_menu ;;
  setup)            shift; cmd_setup "$@" ;;
  status)           shift; cmd_status "$@" ;;
  config)           shift; cmd_config "$@" ;;
  hooks)            shift; cmd_hooks "$@" ;;
  skills)           shift; cmd_skills "$@" ;;
  collect)          shift; cmd_collect "$@" ;;
  gmail-auth)       shift; cmd_gmail_auth "$@" ;;
  update)           shift; cmd_update "$@" ;;
  seed)             shift; cmd_seed "$@" ;;
  compile)          shift; cmd_compile "$@" ;;
  flush)            shift; cmd_flush "$@" ;;
  lint)             shift; cmd_lint "$@" ;;
  query)            shift; cmd_query "$@" ;;
  agent)            shift; cmd_agent "$@" ;;
  correct)          shift; cmd_correct "$@" ;;
  review-wiki)      shift; cmd_review_wiki "$@" ;;
  version)          shift; cmd_version "$@" ;;
  help|-h|--help)   cmd_help ;;
  *)                err "unknown command: $1"; cmd_help; exit 1 ;;
esac
