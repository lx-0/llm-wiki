# ── Top-level interactive home screen ────────────────────────────────
#
# Bare `wiki` (or `wiki menu`) drops into home_screen(). The screen has
# three sections:
#   1. "Pending in your vault" — numbered list of context-sensitive
#      suggestions emitted as JSON by scripts/menu_context.py. Each is
#      picked by its number.
#   2. "Quick actions" — fixed letter shortcuts for the daily-driver
#      commands (q query, f flush, l lint, s status).
#   3. "Browse" — letter shortcuts into category sub-menus that wrap the
#      30+ subcommands via select_one_keyed.
#
# Non-TTY callers (CI, hooks, pipes) never reach this — the entry-point
# at the bottom of this file routes them to cmd_help.

home_query() {
  local q; q="$(ask "Question")"
  [[ -z "$q" ]] && { info "no question; cancelled"; return 0; }
  local mode; mode="$(select_one_keyed "Mode" \
    "default|d|brief (cheapest)|b|file-back (persist as qa/)|f" "d")"
  case "$mode" in
    "default")                            cmd_query "$q" ;;
    "brief (cheapest)")                   cmd_query "$q" --brief ;;
    "file-back (persist as qa/)")         cmd_query "$q" --file-back ;;
  esac
}

home_dispatch_suggestion() {
  # Parse a suggestion's cmd string ("compile" / "curiosity --run-oldest")
  # and route to the matching cmd_* function. Avoids `eval`.
  local cmd_str="$1"
  # shellcheck disable=SC2206
  local -a parts=($cmd_str)
  local sub="${parts[0]}"
  local -a rest=("${parts[@]:1}")
  case "$sub" in
    process-inbox)    cmd_process_inbox "${rest[@]}" ;;
    compile)          cmd_compile "${rest[@]}" ;;
    curiosity)        cmd_curiosity "${rest[@]}" ;;
    suggestions)      cmd_suggestions "${rest[@]}" ;;
    dream)            cmd_dream "${rest[@]}" ;;
    flush)            cmd_flush "${rest[@]}" ;;
    lint)             cmd_lint "${rest[@]}" ;;
    *)                err "no dispatcher for suggested cmd: $sub"; return 1 ;;
  esac
}

