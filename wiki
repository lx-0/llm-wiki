}

home_fuzzy_filter() {
  # User typed "/foo". Find every catalog row whose name contains "foo"
  # (case-insensitive), present a picker, dispatch via the encoded fn.
  # NB: avoids ${var,,} for bash 3.2 compat (macOS default shell).
  local query; query="$(printf "%s" "${1:-}" | tr '[:upper:]' '[:lower:]')"
  [[ -z "$query" ]] && { info "type '/something' to filter"; return 0; }
  local -a matches=()
  while IFS='|' read -r name desc dispatcher; do
    [[ -z "$name" ]] && continue
    local lname; lname="$(printf "%s" "$name" | tr '[:upper:]' '[:lower:]')"
    if [[ "$lname" == *"$query"* ]]; then
      matches+=("$name|$desc|$dispatcher")
    fi
  done < <(_home_command_catalog)

  if (( ${#matches[@]} == 0 )); then
    warn "no command matches '/$query'"
    return 0
  fi
  local picked=""
  if (( ${#matches[@]} == 1 )); then
    picked="${matches[0]}"
    local name="${picked%%|*}"
    info "one match: ${C_BOLD}${name}${C_RESET}"
  else
    echo
    printf "  Matches for ${C_BOLD}/%s${C_RESET}:\n" "$query"
    local i=1
    for row in "${matches[@]}"; do
      local name="${row%%|*}"
      local rest="${row#*|}"
      local desc="${rest%%|*}"
      printf "    %2d) %s%-22s%s %s%s%s\n" \
        "$i" "$C_BOLD" "$name" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      i=$((i+1))
    done
    printf "  Pick a number (Enter to cancel): "
    local pick; if ! read -r pick; then echo; return 0; fi
    [[ -z "$pick" ]] && return 0
    [[ "$pick" =~ ^[0-9]+$ ]] || { warn "not a number"; return 0; }
    if (( pick < 1 || pick > ${#matches[@]} )); then
      warn "out of range"; return 0
    fi
    picked="${matches[$((pick-1))]}"
  fi

  local dispatcher="${picked##*|}"
  echo
  # Dispatcher may be "prompt:Label:cmd args" (needs one arg) or plain
  # function call (e.g. "cmd_compile" / "cmd_lint --structural-only").
  if [[ "$dispatcher" == prompt:* ]]; then
    local rest="${dispatcher#prompt:}"
    local label="${rest%%:*}"
    local cmd_str="${rest#*:}"
    local arg; arg="$(ask "$label")"
    [[ -z "$arg" ]] && { info "cancelled"; return 0; }
    # shellcheck disable=SC2086
    eval "$cmd_str \"\$arg\""
  else
    # shellcheck disable=SC2086
    eval "$dispatcher"
  fi
}

home_screen() {
  local revision vault_name
  revision="$(git -C "$WIKI_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  vault_name="$(basename "$ROOT_DIR")"
  while :; do
    echo
    printf "  %s%swiki%s — %s vault (commit %s)\n" \
      "$C_BOLD" "$C_CYAN" "$C_RESET" "$vault_name" "$revision"

    # Probe the vault. Hard timeout lives inside menu_context.py; here we
    # only guard against the process itself failing.
    local payload_json
    payload_json="$(uv run --quiet --project "$WIKI_DIR" \
      python "$WIKI_DIR/scripts/menu_context.py" 2>/dev/null)"
    [[ -z "$payload_json" ]] && payload_json='{"status":{},"suggestions":[]}'
    local status_json suggestions_json
    status_json="$(jq -c '.status' <<<"$payload_json" 2>/dev/null || echo '{}')"
    suggestions_json="$(jq -c '.suggestions' <<<"$payload_json" 2>/dev/null || echo '[]')"

    home_render_status "$status_json"
    echo

    local n_suggestions
    n_suggestions="$(jq 'length' <<<"$suggestions_json" 2>/dev/null || echo 0)"

    if (( n_suggestions > 0 )); then
      printf "  %s▸ Pending in your vault%s\n" "$C_BOLD" "$C_RESET"
      while IFS=$'\t' read -r key label cmd; do
        printf "      %s%s)%s %-44s %s→ wiki %s%s\n" \
          "$C_GREEN" "$key" "$C_RESET" "$label" "$C_DIM" "$cmd" "$C_RESET"
      done < <(jq -r '.[] | [.key, .label, .cmd] | @tsv' <<<"$suggestions_json")
      echo
    else
      printf "  %s✨ Nothing pending — vault is current.%s\n\n" \
        "$C_DIM" "$C_RESET"
    fi

    printf "  %s▸ Quick actions%s\n" "$C_BOLD" "$C_RESET"
    printf "      [%sq%s] query     [%sf%s] flush     [%sl%s] lint     [%ss%s] status\n" \
      "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET"
    echo
    printf "  %s▸ Browse%s\n" "$C_BOLD" "$C_RESET"
    printf "      [%sc%s] collectors    [%si%s] ingest    [%sk%s] knowledge ops\n" \
      "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET"
    printf "      [%sd%s] facts/takes   [%sa%s] automation [%sg%s] setup\n" \
      "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET"
    echo
    printf "      [%sh%s] full help     [%sx%s] exit     %s(type %s/foo%s to filter all commands)%s\n" \
      "$C_BOLD" "$C_RESET" "$C_BOLD" "$C_RESET" \
      "$C_DIM" "$C_BOLD" "$C_RESET$C_DIM" "$C_RESET"
    echo
    printf "  Pick one: "
    local choice
    # EOF (Ctrl-D, closed pipe) exits the menu cleanly.
    if ! read -r choice; then echo; break; fi

    # `/foo` → fuzzy filter across the full command catalog.
    if [[ "$choice" == /* ]]; then
      home_fuzzy_filter "${choice#/}" || true
      echo; pause; continue
    fi

    # Numeric → dispatch a suggestion.
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= n_suggestions )); then
      local cmd_str
      cmd_str="$(jq -r ".[$((choice-1))].cmd" <<<"$suggestions_json")"
      echo
      home_dispatch_suggestion "$cmd_str" || true
      echo; pause; continue
    fi

    case "$choice" in
      q)                    echo; home_query ;;
      f)                    echo; cmd_flush ;;
      l)                    echo; cmd_lint --structural-only ;;
      s)                    echo; cmd_status ;;
      c)                    echo; category_menu collectors ;;
      i)                    echo; category_menu ingest ;;
      k)                    echo; category_menu knowledge ;;
      d)                    echo; category_menu facts ;;
      a)                    echo; category_menu automation ;;
      g)                    echo; category_menu setup ;;
      h)                    echo; cmd_help ;;
      x|"")                 break ;;
      *)                    warn "unknown choice: $choice" ;;
    esac
    echo
    pause
  done
}

# ── Entry point ──────────────────────────────────────────────────────
# Bare `wiki` opens the interactive home screen ONLY when stdin/stdout are
# both TTYs. Non-TTY callers (CI, pipes, hooks, cron) get the help dump
# and exit 0 — they never block waiting for input.
case "${1:-}" in
  "")
    if [[ -t 0 && -t 1 ]]; then
      home_screen
    else
      cmd_help
    fi
    ;;
  menu)             home_screen ;;
  setup)            shift; cmd_setup "$@" ;;
  status)           shift; cmd_status "$@" ;;
  config)           shift; cmd_config "$@" ;;
  hooks)            shift; cmd_hooks "$@" ;;
  skills)           shift; cmd_skills "$@" ;;
  collect)          shift; cmd_collect "$@" ;;
  gmail-auth)       shift; cmd_gmail_auth "$@" ;;
  gmeet-auth)       shift; cmd_gmeet_auth "$@" ;;
  calendar-auth)    shift; cmd_calendar_auth "$@" ;;
  update)           shift; cmd_update "$@" ;;
  seed)             shift; cmd_seed "$@" ;;
  compile)          shift; cmd_compile "$@" ;;
  dream-entity)     shift; cmd_dream_entity "$@" ;;
  dream)            shift; cmd_dream "$@" ;;
  flush)            shift; cmd_flush "$@" ;;
  lint)             shift; cmd_lint "$@" ;;
  query)            shift; cmd_query "$@" ;;
  agent)            shift; cmd_agent "$@" ;;
  correct)          shift; cmd_correct "$@" ;;
  take)             shift; cmd_take "$@" ;;
  pin)              shift; cmd_pin "$@" ;;
  review-wiki)      shift; cmd_review_wiki "$@" ;;
  process-inbox)    shift; cmd_process_inbox "$@" ;;
  ingest-html)      shift; cmd_ingest_html "$@" ;;
  ingest-youtube)   shift; cmd_ingest_youtube "$@" ;;
  curiosity)        shift; cmd_curiosity "$@" ;;
  suggestions)      shift; cmd_suggestions "$@" ;;
  version)          shift; cmd_version "$@" ;;
  help|-h|--help)   cmd_help ;;
  *)                err "unknown command: $1"; cmd_help; exit 1 ;;
esac
