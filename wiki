}

cmd_dream() {
  case "${1:-sweep}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki dream${C_RESET} — sweep all entity pages (M014)

${C_BOLD}USAGE${C_RESET}
  wiki dream                               sweep all entities, oldest-overdue first (default)
  wiki dream --dry-run                     print plan, no SDK calls
  wiki dream --limit N                     hard cap on entity count this run
  wiki dream list-candidates               debug: print scored candidate list, no run
  wiki dream web-research <slug>           public-entity web enrichment (issue #2, Exa)
  wiki dream web-research <slug> --dry-run print the Public Profile block, write nothing

${C_BOLD}NOTES${C_RESET}
  Sweeps \`knowledge/{people,projects,areas}/*.md\` oldest-synthesized first,
  skipping entities synthesized within the cooldown window. Per-entity AND
  per-run cumulative cost caps are enforced — see \`wiki dream-entity help\`.
  \`--all-entities\` / \`sweep\` are accepted as legacy aliases.
EOF
      return 0 ;;
    --all-entities|sweep)
      [ $# -gt 0 ] && shift
      banner "wiki dream sweep"; _run_script dream.py sweep "$@" ;;
    list-candidates|--list-candidates)
      shift; banner "wiki dream list-candidates"; _run_script dream.py list-candidates "$@" ;;
    web-research|--web-research-only)
      shift; banner "wiki dream web-research"; _run_script dream.py web-research "$@" ;;
    --*)
      # Bare flags (e.g. `wiki dream --dry-run --limit 3`) → implicit sweep
      banner "wiki dream sweep"; _run_script dream.py sweep "$@" ;;
    *)
      err "unknown: wiki dream $1 (try 'wiki dream help')"; return 1 ;;
  esac
}

cmd_seed() {
  local force=0 check=0 only="" extract=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)                  force=1; shift ;;
      --check)                  check=1; shift ;;
      --extract-custom)         extract=1; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki seed${C_RESET} — re-apply engine templates to the vault root

${C_BOLD}USAGE${C_RESET}
  wiki seed                     additive: add missing files, merge community-plugins
  wiki seed --check             read-only audit: report which templates have drifted
  wiki seed --force             overwrite existing vault templates with engine versions
  wiki seed <path> [--force|--check]   restrict to ONE file (surgical refresh)
  wiki seed --extract-custom <path>    capture a JSON config's drift into an overlay

${C_BOLD}WHAT IT DOES${C_RESET}
  - Seeds missing files: README.md, AGENTS.md, dashboard.md, knowledge.base, .claude/.env.example
  - Seeds missing .obsidian/*.json + .obsidian/plugins/<name>/data.json
  - Merges community-plugins.json (additive — adds engine plugins, never drops yours)
  - Cache files (_dashboard-*.md) are NOT seeded — first \`wiki flush\` writes them.

${C_BOLD}TARGETED (single file)${C_RESET}
  Pass a vault-relative path to act on just that file — every other template is
  left untouched. Lets you refresh ONE stale file with --force without clobbering
  unrelated customisations (e.g. your QuickAdd macros or graph palette):
    wiki seed AGENTS.md --check          # audit just AGENTS.md
    wiki seed AGENTS.md --force          # refresh just AGENTS.md
    wiki seed .obsidian/app.json --check

${C_BOLD}CONFIG OVERLAYS (JSON configs — graph.json, app.json, plugin data.json)${C_RESET}
  These are derived as ${C_DIM}engine-template ⊕ your overlay${C_RESET}: the engine owns the
  base (so new-feature keys flow in on update), your customisations live in an
  untracked overlay at ${C_DIM}<vault>/.wiki/custom/<path>${C_RESET}. Edit the overlay, not
  the live file — then \`--force\` re-derives non-destructively. To migrate an
  already-customised file, capture its current drift into an overlay once:
    wiki seed --extract-custom .obsidian/graph.json   # drift → .wiki/custom/...
    # …then edit .wiki/custom/.obsidian/graph.json going forward
    wiki seed .obsidian/graph.json --force            # re-derive base ⊕ overlay
  Markdown/YAML files (AGENTS.md, dashboard.md) are engine-owned — no overlay;
  refresh them with a targeted --force.

${C_BOLD}DRIFT REPORTING${C_RESET}
  Default mode tags each kept-existing file as either ${C_DIM}up-to-date${C_RESET} or
  ${C_DIM}drifted from engine${C_RESET}. \`--check\` runs the same audit without writing
  anything — use it after \`wiki update\` to see what would change before
  deciding whether to \`--force\` or merge manually. JSON files that differ only
  in key order are reported up-to-date, not drifted.

${C_BOLD}SAFETY${C_RESET}
  Default mode never overwrites your edits. Use --force only if you want to
  discard your customisations and pick up the latest engine version. Combine
  --force with a <path> to scope the overwrite to a single file.
EOF
        return 0 ;;
      --*)                      err "unknown flag: $1"; exit 1 ;;
      *)
        if [[ -n "$only" ]]; then
          err "wiki seed takes at most one path (got '$only' and '$1')"; exit 1
        fi
        only="$1"; shift ;;
    esac
  done
  if (( check == 1 && force == 1 )); then
    err "--check and --force are mutually exclusive"; exit 1
  fi
  if (( extract == 1 )); then
    [[ -n "$only" ]] || { err "usage: wiki seed --extract-custom <vault-relative-path>"; exit 1; }
    banner "wiki seed --extract-custom" "$only"
    seed_extract_custom "$ROOT_DIR" "$WIKI_DIR" "$only"
    return $?
  fi
  local mode
  if (( check == 1 )); then mode='audit (read-only)'
  elif (( force == 1 )); then mode='overwrite mode'
  else mode='additive mode'
  fi
  [[ -n "$only" ]] && mode="$mode · only: $only"
  banner "wiki seed" "$mode"
  seed_vault_templates "$ROOT_DIR" "$WIKI_DIR" "$force" "$check" "$only"
  # In audit mode we don't refresh dashboards — that's a side-effect of seeding.
  if (( check == 0 )); then
    _refresh_dashboards
  fi
}


cmd_update() {
  local sync_skills=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-skills)              sync_skills=0; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki update${C_RESET} — git pull --ff-only the .wiki/ checkout

${C_BOLD}USAGE${C_RESET}
  wiki update                   pull + sync skill symlinks
  wiki update --no-skills       pull only, skip skill sync

${C_BOLD}NOTES${C_RESET}
  If the .wiki/ checkout has uncommitted changes to tracked engine files
  (a --ff-only pull would abort on them), \`wiki update\` shows them and
  offers to \`git stash\` them so the pull can proceed. After the pull the
  stash is re-applied automatically — but only if it merges cleanly onto the
  new engine. If it would conflict, it's left unpopped (recover with
  \`git -C <.wiki> stash pop\`). Run from a terminal: non-interactively the
  command refuses rather than touching your changes.
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  # Ask git, don't stat `.git`: it is a FILE (`gitdir: <path>`), not a directory,
  # whenever the repo is a linked worktree, a submodule, or has had its git-dir
  # relocated — e.g. to keep the 770 MB of packfiles out of an iCloud-synced
  # vault. A `-d` test reports "not a checkout" for all three.
  if ! git -C "$WIKI_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    die "Not a git checkout — wiki/ wasn't installed via install.sh. Manual update required."
  fi

  # Dirty-tree guard. `git pull --ff-only` aborts if tracked engine files have
  # local modifications (the "zombie-modified" case from direct edits inside
  # <vault>/.wiki/). config.yaml, state/, logs/ are gitignored, so a dirty tree
  # here means real engine-file edits — offer to stash them out of the way so
  # the pull can proceed, instead of failing with a generic "resolve manually".
  # Untracked files are left untouched (no `stash -u`).
  local stashed=0
  if ! git -C "$WIKI_DIR" diff --quiet || ! git -C "$WIKI_DIR" diff --cached --quiet; then
    warn "Uncommitted changes in $WIKI_DIR (tracked engine files):"
    git -C "$WIKI_DIR" status --short --untracked-files=no
    if [[ ! -t 0 ]]; then
      die "Refusing to touch them non-interactively. Run \`wiki update\` from a terminal to stash, or commit/stash manually in $WIKI_DIR."
    fi
    if confirm "Stash these changes, update, then re-apply them?" n; then
      local stash_msg="wiki-update auto-stash $(date +%Y-%m-%d-%H%M%S)"
      if git -C "$WIKI_DIR" stash push -m "$stash_msg"; then
        stashed=1
        ok "Stashed local changes (will re-apply after the pull if they merge cleanly)."
      else
        die "git stash failed. Resolve manually in $WIKI_DIR."
      fi
    else
      die "Update aborted — uncommitted changes left in place. Commit or stash them, then re-run \`wiki update\`."
    fi
  fi

  local before; before="$(git -C "$WIKI_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  info "Pulling latest into $WIKI_DIR …"
  if ! git -C "$WIKI_DIR" pull --ff-only; then
    # Pull failed (non-ff / network). HEAD didn't move, so a stash we just made
    # pops cleanly back onto the unchanged base — restore it so the operator's
    # changes aren't left hidden by a failed update.
    if (( stashed == 1 )); then
      git -C "$WIKI_DIR" stash pop >/dev/null 2>&1 \
        && warn "Restored your stashed changes (pull did not run)." \
        || warn "Could not auto-restore stash — recover with: git -C \"$WIKI_DIR\" stash pop"
    fi
    die "git pull failed (non-fast-forward or network). Resolve manually in $WIKI_DIR."
  fi

  # Re-apply stashed local changes onto the freshly-pulled engine — but only if
  # they merge cleanly. Test with `git apply --check` against the new tree
  # FIRST: if the patch would conflict we leave the stash unpopped (recoverable)
  # rather than dropping conflict markers into the checkout mid-update. The
  # check errs safe — a near-miss leaves the stash for manual resolution.
  if (( stashed == 1 )); then
    if git -C "$WIKI_DIR" stash show -p stash@{0} 2>/dev/null \
         | git -C "$WIKI_DIR" apply --check - 2>/dev/null; then
      if git -C "$WIKI_DIR" stash pop >/dev/null 2>&1; then
        ok "Re-applied your stashed changes cleanly."
      else
        warn "Stash re-apply failed unexpectedly — your changes are still stashed."
        warn "  recover with: git -C \"$WIKI_DIR\" stash pop"
      fi
    else
      warn "Stashed changes would conflict with the update — left unpopped."
      warn "  recover with: git -C \"$WIKI_DIR\" stash pop  (then resolve conflicts)"
    fi
  fi
  local after; after="$(git -C "$WIKI_DIR" rev-parse --short HEAD)"
  if [[ "$before" == "$after" ]]; then
    ok "Already up to date ($before)"
  else
    ok "Updated $before → $after"
    info "If hook payloads or config schema changed, you may want to re-run:"
    info "  wiki hooks install      ${C_DIM}# to refresh agent hook configs${C_RESET}"
  fi

  # Sync Python deps so pyproject.toml changes (new dependency, version bump)
  # actually land in the vault's venv. Without this, an engine pull that adds
  # a new `dependencies = [...]` entry is invisible to runtime: the venv stays
  # on the prior resolution, imports of the new package silently fail through
  # whatever ImportError-fallback the calling code has, and operators see
  # features that "work in the engine repo but not in their vault".
  # Incident 2026-05-29: pillow was added to pyproject.toml so the pictures
  # collector's EXIF extractor could read JPEG metadata; vault venvs synced
  # before that update returned `{}` from `_parse_exif()` because PIL wasn't
  # installed, and the device.software field silently never landed.
  info "Syncing Python dependencies (uv sync, idempotent) …"
  if ! uv sync --project "$WIKI_DIR" --quiet; then
    warn "uv sync reported errors — runtime imports may fail. Run 'uv sync --project $WIKI_DIR' manually."
  fi

  # Run config-schema migration unconditionally — idempotent, prints
  # "no change" when the vault is already on the current schema, prints
  # the rename/add/drop diff and applies it otherwise. Keeps the vault's
  # config.yaml in sync with whatever the engine pull just introduced.
  info "Migrating config.yaml to current schema (idempotent) …"
  if ! uv run --quiet --project "$WIKI_DIR" python \
        "$WIKI_DIR/scripts/migrations/migrate_config_keys.py" \
        --vault "$ROOT_DIR" --apply; then
    warn "Config migration reported errors — inspect $ROOT_DIR/.wiki/config.yaml manually."
  fi

  # Relocate knowledge/log.md → .wiki/logs/operations.md (idempotent).
  # Pre-2026-05-28 vaults carry a 2 MB audit log inside knowledge/ that
  # crashes Obsidian on open. The log is engine telemetry, not knowledge.
  info "Relocating operations log out of knowledge/ (idempotent) …"
  if ! uv run --quiet --project "$WIKI_DIR" python \
        "$WIKI_DIR/scripts/migrations/migrate_log_md_path.py" \
        --vault "$ROOT_DIR"; then
    warn "Operations-log migration reported errors — inspect $ROOT_DIR/knowledge/log.md manually."
  fi

  if (( sync_skills == 1 )); then
    skills_cmd_sync
  else
    info "skills: skipped (--no-skills)"
  fi
}

cmd_version() {
  # See cmd_update: `.git` is a file, not a directory, for worktrees, submodules
  # and relocated git-dirs — ask git instead of stat-ing the path.
  if git -C "$WIKI_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    local rev; rev="$(git -C "$WIKI_DIR" rev-parse --short HEAD)"
    local tag; tag="$(git -C "$WIKI_DIR" describe --tags --always 2>/dev/null || echo "")"
    local origin; origin="$(git -C "$WIKI_DIR" config --get remote.origin.url 2>/dev/null || echo "")"
    printf "%-12s %s\n" "revision" "$rev"
    [[ -n "$tag" && "$tag" != "$rev" ]] && printf "%-12s %s\n" "tag" "$tag"
    [[ -n "$origin" ]] && printf "%-12s %s\n" "origin" "$origin"
  else
    warn "Not a git checkout. Cannot report version."
  fi
}

# ── Top-level interactive home screen ────────────────────────────────
#
# Bare `wiki` (or `wiki menu`) execs `scripts/menu.py`, which owns the
# entire interactive flow (suggestions / quick actions / browse / fuzzy
# filter) via prompt_toolkit. The Python menu shells back to `wiki
# <subcommand>` for every dispatch — bash stays the single source of
# truth for what each subcommand does. Non-TTY callers reach `cmd_help`
# directly via the entry-point's `-t` guard.
#
# Why Python and not bash: the bash home_screen this replaced (live
# 2026-05-17 morning) trip-wired on bash 3.2 quirks once per feature —
# `${var,,}` missing, empty-array under `set -u`, fractional `read -t`
# unsupported. prompt_toolkit handles arrow keys + redraw + raw mode
# natively. See `.ytstack/backlog/python-interactive-menu.md`.

home_screen_python() {
  exec uv run --quiet --project "$WIKI_DIR" \
    python "$WIKI_DIR/scripts/menu.py"
}

cmd_menu() {
  # `wiki menu` — open the interactive home screen (TTY).
  # `wiki menu --json` — agent-facing read of suggestions + status payload.
  case "${1:-}" in
    --json)
      exec uv run --quiet --project "$WIKI_DIR" \
        python "$WIKI_DIR/scripts/menu_context.py"
      ;;
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki menu${C_RESET} — interactive home screen + agent-facing JSON

${C_BOLD}USAGE${C_RESET}
  wiki menu                interactive home screen (prompt_toolkit-driven)
  wiki menu --json         emit suggestions + status JSON, exit
                           (consumed by use-llm-wiki skill)
EOF
      return 0
      ;;
    "")
      home_screen_python
      ;;
    *)
      err "unknown: wiki menu ${1:-}"
      return 1
      ;;
  esac
}

cmd_doctor() {
  # `wiki doctor` — full vault-health audit (config + connectivity + pipeline).
  # `wiki doctor --json` — machine-readable for agents.
  # `wiki doctor --quick` — skip TCP + subprocess probes (sub-50ms, for hooks).
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki doctor${C_RESET} — vault-health audit

${C_BOLD}USAGE${C_RESET}
  wiki doctor              full pretty report (config / connectivity / pipeline)
  wiki doctor --json       machine-readable (for agents)
  wiki doctor --quick      skip TCP + subprocess probes (~50ms; for hooks)
  wiki doctor --quick --json   both

${C_BOLD}EXIT CODE${C_RESET}
  0   no critical issues
  1   at least one critical issue

${C_BOLD}CHECKS${C_RESET}
  Config + setup: setup-wizard-ran, hooks-installed, template-drift, engine-update-available
  Connectivity: ollama-reachable, claude-authed
  Pipeline: compile-errors-recent, no-knowledge-articles, compile-state
EOF
      return 0
      ;;
  esac
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/doctor.py" "$@"
}

cmd_install_shortcut() {
  # Create a `wiki` shortcut in `~/.local/bin/wiki` → vault's `.wiki/wiki`.
  # Operator-asked: typing `wiki` from any cwd should Just Work, not require
  # `./.wiki/wiki` or the iCloud-path expansion. Idempotent — replaces an
  # existing symlink if it points elsewhere; no-op if it already points here.
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki install-shortcut${C_RESET} — create \`wiki\` symlink on PATH

${C_BOLD}USAGE${C_RESET}
  wiki install-shortcut         create ~/.local/bin/wiki → this vault's wiki
  wiki install-shortcut --print-only   show what would happen, don't write

Idempotent. Replaces a stale symlink pointing at a different vault.
Reports if ~/.local/bin isn't on PATH and prints the one-line shell-rc
edit needed.
EOF
      return 0
      ;;
  esac

  local print_only=0
  [[ "${1:-}" == "--print-only" ]] && print_only=1

  local bin_dir="$HOME/.local/bin"
  local link="$bin_dir/wiki"
  local target="$WIKI_DIR/wiki"

  banner "wiki install-shortcut"

  if [[ ! -x "$target" ]]; then
    err "target $target is not executable (engine install broken?)"
    return 1
  fi

  if (( print_only )); then
    info "would create: $link → $target"
  else
    mkdir -p "$bin_dir"
    if [[ -L "$link" || -e "$link" ]]; then
      local current; current="$(readlink "$link" 2>/dev/null || echo)"
      if [[ "$current" == "$target" ]]; then
        ok "already linked: $link → $target"
      else
        info "replacing existing: $link → $current"
        rm -f "$link"
        ln -s "$target" "$link"
        ok "linked: $link → $target"
      fi
    else
      ln -s "$target" "$link"
      ok "linked: $link → $target"
    fi
  fi

  # Probe whether ~/.local/bin is on PATH for the operator's current shell.
  case ":$PATH:" in
    *":$bin_dir:"*)
      ok "$bin_dir is on PATH — typing \`wiki\` from any cwd will work"
      ;;
    *)
      warn "$bin_dir is NOT on PATH"
      echo
      info "Add this line to your shell rc (~/.zshrc on macOS default):"
      printf "  ${C_BOLD}export PATH="\$HOME/.local/bin:\$PATH"${C_RESET}
"
      info "Then reload: \`source ~/.zshrc\` (or open a new terminal)."
      ;;
  esac
}

# ── Entry point ──────────────────────────────────────────────────────
# Bare `wiki` opens the interactive home screen ONLY when stdin/stdout are
# both TTYs. Non-TTY callers (CI, pipes, hooks, cron) get the help dump
# and exit 0 — they never block waiting for input.

# Guard before dispatch: every subcommand except help/version touches vault
# state, so demand a vault. Help + version must work in a bare checkout.
case "${1:-}" in
  help|-h|--help|version|install-shortcut) ;;
  *) require_vault ;;
esac

# Bash keeps only bootstrap + the genuinely-bash commands (and the bespoke
# dream / dream-entity argv routing + the OAuth aliases). Every other
# subcommand — the Python-backed ones — is delegated to scripts/cli.py, which
# is the single source of truth for the command catalog, the once-locked
# dashboard refresh, and the argv-safe OAuth bootstrap. An unknown command
# falls through to cli.py, which prints its own "unknown command" error.
case "${1:-}" in
  "")
    if [[ -t 0 && -t 1 ]]; then
      home_screen_python
    else
      cmd_help
    fi
    ;;
  menu)             shift; cmd_menu "$@" ;;
  doctor)           shift; cmd_doctor "$@" ;;
  install-shortcut) shift; cmd_install_shortcut "$@" ;;
  setup)            shift; cmd_setup "$@" ;;
  status)           shift; cmd_status "$@" ;;
  config)           shift; cmd_config "$@" ;;
  hooks)            shift; cmd_hooks "$@" ;;
  skills)           shift; cmd_skills "$@" ;;
  update)           shift; cmd_update "$@" ;;
  seed)             shift; cmd_seed "$@" ;;
  dream-entity)     shift; cmd_dream_entity "$@" ;;
  dream)            shift; cmd_dream "$@" ;;
  version)          shift; cmd_version "$@" ;;
  help|-h|--help)   cmd_help ;;
  # OAuth aliases — remap to the argv-safe `wiki auth <service> <id>` dispatch.
  gmail-auth)       shift; _dispatch_python auth gmail "$@" ;;
  gmeet-auth)       shift; _dispatch_python auth gmeet "$@" ;;
  calendar-auth)    shift; _dispatch_python auth calendar "$@" ;;
  # Everything else is a Python-backed subcommand owned by the cli.py table
  # (unknown names error there). "$@" still carries the command name.
  *)                _dispatch_python "$@" ;;
esac
