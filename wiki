#!/usr/bin/env bash
# wiki — single entry-point CLI for the wiki/ system.
#
# The command catalog is NOT maintained here. `scripts/cli_catalog.py` owns the
# full table of subcommands (name, handler, banner, refresh-after; the per-command
# help texts sit in `scripts/cli_help.py`) and is the single source of truth for
# `wiki help`. The home menu keeps its own action table (`scripts/menu.py` +
# `scripts/core/actions.py`) — folding the two is M034's. This bash layer only does
# bootstrap (symlink resolution + vault guard) and the part of one command not yet
# ported (update's pull; its second phase is scripts/update_cli.py). Every other
# subcommand — bare `wiki`, help, menu, doctor, version, config, setup,
# install-shortcut, hooks, skills, status, seed, the dream routing and the OAuth
# aliases included — is delegated to `scripts/cli.py` in one hop,
# which also owns the once-locked dashboard refresh and the OAuth bootstrap
# (`wiki auth <service> <account-id>`).

set -euo pipefail

# Resolve symlinks so `wiki` invoked via ~/.local/bin/wiki (created by
# `wiki install-shortcut`) still finds lib/* relative to the real script
# location, not relative to the symlink path. macOS `readlink -f` lives
# in coreutils (greadlink) and isn't guaranteed; use a portable Python
# fallback via the script's own dirname loop.
_resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  cd "$(dirname "$src")" && pwd
}
WIKI_DIR="$(_resolve_self)"
ROOT_DIR="$(cd "$WIKI_DIR/.." && pwd)"
export WIKI_DIR ROOT_DIR

# shellcheck source=lib/common.sh
source "$WIKI_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$WIKI_DIR/lib/ui.sh"

require_cmd uv "needed to sync and run the engine's Python environment"

# ── Vault guard ──────────────────────────────────────────────────────
# Engine refuses to run outside an Obsidian vault. Without this, a bare
# checkout of the engine repo gets treated as a vault by paths.py
# (WIKI_DIR=<repo>, ROOT_DIR=<parent>) and `wiki <foo>` scribbles
# logs/, state/, reports/, config.yaml into the engine source tree.
# Marker: `.obsidian/` at ROOT_DIR — the canonical user-facing vault signal.
require_vault() {
  if [[ ! -d "$ROOT_DIR/.obsidian" ]]; then
    >&2 echo "wiki: $ROOT_DIR is not an Obsidian vault (no .obsidian/ directory)."
    >&2 echo "    The engine only runs against real vaults — install it as <vault>/.wiki/"
    >&2 echo "    and invoke \`wiki\` from there."
    exit 1
  fi
}

# ── Subcommand dispatchers ───────────────────────────────────────────
# `wiki status`, `wiki hooks` (M034-S03-T05), `wiki skills` (M034-S03-T06), `wiki seed`
# (M034-S04-T04) and update's second phase (M034-S05-T02) are Python: status_cli.py,
# hooks_cli.py, skills_cli.py, seed_cli.py, update_cli.py.


_dispatch_python() {
  # Delegate a Python-backed subcommand to the table-driven dispatcher, in one hop
  # (DECISIONS 2026-10-15 "One hop"): `exec` the venv's Python straight into
  # cli.py, so cli.py owns the process (banner, run, once-locked refresh) and its
  # exit code reaches the caller, with no `uv run` parent costing ~57 ms per call.
  # The venv is lib/common.sh's one rule: UV_PROJECT_ENVIRONMENT, else .wiki/.venv.
  # A relative UV_PROJECT_ENVIRONMENT is uv's to resolve, so it stays on `uv run`.
  local venv="${UV_PROJECT_ENVIRONMENT:-$WIKI_DIR/.venv}"
  case "$venv" in
    /*) ;;
    *) exec uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/cli.py" "$@" ;;
  esac
  # `uv run` also synced the venv whenever uv.lock / pyproject.toml changed (a pull
  # outside `wiki update`, a hand edit). Kept: no venv yet, or either file newer than
  # the last sync's stamp → `uv sync` first. `--inexact` is `uv run`'s sync (it never
  # removes extra packages). A failed sync stops here, stamp untouched — and says so: a
  # uv that cannot run at all (an asdf shim under a foreign HOME exits 126) prints nothing
  # of its own. The hint (lib/common.sh's sync_hint) names the venv, so following it never
  # recreates .wiki/.venv inside a cloud-synced vault.
  local stamp="$venv/.wiki-synced"
  if [[ ! -x "$venv/bin/python" || "$WIKI_DIR/uv.lock" -nt "$stamp" \
        || "$WIKI_DIR/pyproject.toml" -nt "$stamp" ]]; then
    if ! uv sync --quiet --inexact --project "$WIKI_DIR"; then
      die "uv sync failed — the engine's environment is behind uv.lock. To see why, run:
  $(sync_hint)"
    fi
    touch "$stamp"
  fi
  # What `uv run` puts in the environment, measured: the venv's bin/ first on PATH and
  # VIRTUAL_ENV (its UV / UV_RUN_RECURSION_DEPTH have no reader in the engine).
  export VIRTUAL_ENV="$venv" PATH="$venv/bin:$PATH"
  exec "$venv/bin/python" "$WIKI_DIR/scripts/cli.py" "$@"
}


cmd_update() {
  local sync_skills=1 post_pull=0 before=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-skills)              sync_skills=0; shift ;;
      # Internal: the second phase, re-executed from the freshly pulled engine
      # (see the exec at the end of the first phase). Carries the pre-pull
      # revision for the summary line.
      --post-pull)              post_pull=1; before="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki update${C_RESET} — git pull --ff-only the .wiki/ checkout

${C_BOLD}USAGE${C_RESET}
  wiki update                   pull + sync skill symlinks
  wiki update --no-skills       pull only, skip skill sync

${C_BOLD}NOTES${C_RESET}
  If the .wiki/ checkout has uncommitted changes to tracked engine files
  (a --ff-only pull would abort on them), \`wiki update\` shows them and
  offers to \`git stash\` them so the pull can proceed. After the pull the
  stash is re-applied automatically — but only if it merges cleanly onto the
  new engine. If it would conflict, it's left unpopped (recover with
  \`git -C <.wiki> stash pop\`). Run from a terminal: non-interactively the
  command refuses rather than touching your changes.

  Everything after the pull (dependency sync, migrations, skills sync) runs
  from the engine just pulled — the command re-executes itself — so a changed
  update procedure applies in the same run, not the next one.
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  # Ask git, don't stat `.git`: it is a FILE (`gitdir: <path>`), not a directory,
  # whenever the repo is a linked worktree, a submodule, or has had its git-dir
  # relocated — e.g. to keep the 770 MB of packfiles out of an iCloud-synced
  # vault. A `-d` test reports "not a checkout" for all three.
  if ! git -C "$WIKI_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    die "Not a git checkout — $WIKI_DIR wasn't installed via install.sh. Manual update required."
  fi
  # The second phase is Python (scripts/update_cli.py, M034-S05-T02); this bash checked its
  # flags and the checkout, as it does for a 0.7.3 bash that re-executes into it.
  if (( post_pull == 1 )); then
    if (( sync_skills == 1 )); then
      _dispatch_python update --post-pull "$before"
    else
      _dispatch_python update --post-pull "$before" --no-skills
    fi
  fi

  # Dirty-tree guard. `git pull --ff-only` aborts if tracked engine files have
  # local modifications (the "zombie-modified" case from direct edits inside
  # <vault>/.wiki/). config.yaml, state/, logs/ are gitignored, so a dirty tree
  # here means real engine-file edits — offer to stash them out of the way so
  # the pull can proceed, instead of failing with a generic "resolve manually".
  # Untracked files are left untouched (no `stash -u`).
  local stashed=0
  if ! git -C "$WIKI_DIR" diff --quiet || ! git -C "$WIKI_DIR" diff --cached --quiet; then
    warn "Uncommitted changes in $WIKI_DIR (tracked engine files):"
    git -C "$WIKI_DIR" status --short --untracked-files=no
    if [[ ! -t 0 ]]; then
      die "Refusing to touch them non-interactively. Run \`wiki update\` from a terminal to stash, or commit/stash manually in $WIKI_DIR."
    fi
    if confirm "Stash these changes, update, then re-apply them?" n; then
      local stash_msg="wiki-update auto-stash $(date +%Y-%m-%d-%H%M%S)"
      if git -C "$WIKI_DIR" stash push -m "$stash_msg"; then
        stashed=1
        ok "Stashed local changes (will re-apply after the pull if they merge cleanly)."
      else
        die "git stash failed. Resolve manually in $WIKI_DIR."
      fi
    else
      die "Update aborted — uncommitted changes left in place. Commit or stash them, then re-run \`wiki update\`."
    fi
  fi

  local before; before="$(git -C "$WIKI_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  info "Pulling latest into $WIKI_DIR …"
  if ! git -C "$WIKI_DIR" pull --ff-only; then
    # Pull failed (non-ff / network). HEAD didn't move, so a stash we just made
    # pops cleanly back onto the unchanged base — restore it so the operator's
    # changes aren't left hidden by a failed update.
    if (( stashed == 1 )); then
      git -C "$WIKI_DIR" stash pop >/dev/null 2>&1 \
        && warn "Restored your stashed changes (pull did not run)." \
        || warn "Could not auto-restore stash — recover with: git -C \"$WIKI_DIR\" stash pop"
    fi
    die "git pull failed (non-fast-forward or network). Resolve manually in $WIKI_DIR."
  fi

  # Re-apply stashed local changes onto the freshly-pulled engine — but only if
  # they merge cleanly. Test with `git apply --check` against the new tree
  # FIRST: if the patch would conflict we leave the stash unpopped (recoverable)
  # rather than dropping conflict markers into the checkout mid-update. The
  # check errs safe — a near-miss leaves the stash for manual resolution.
  if (( stashed == 1 )); then
    if git -C "$WIKI_DIR" stash show -p stash@{0} 2>/dev/null \
         | git -C "$WIKI_DIR" apply --check - 2>/dev/null; then
      if git -C "$WIKI_DIR" stash pop >/dev/null 2>&1; then
        ok "Re-applied your stashed changes cleanly."
      else
        warn "Stash re-apply failed unexpectedly — your changes are still stashed."
        warn "  recover with: git -C \"$WIKI_DIR\" stash pop"
      fi
    else
      warn "Stashed changes would conflict with the update — left unpopped."
      warn "  recover with: git -C \"$WIKI_DIR\" stash pop  (then resolve conflicts)"
    fi
  fi

  # Everything after the pull runs from the engine that was just pulled, not
  # from this bash, which was parsed before the pull: a changed spawn shape or
  # a new post-pull step takes effect in the same update, not the next one.
  # 2026-10-14: the pre-M033-S02 bash spawned the migrations by file path; the
  # pulled tree runs them only as modules, so the first update across that
  # change warned `ModuleNotFoundError: core` and skipped the config migration.
  local skills_flag=""
  if (( sync_skills == 0 )); then skills_flag="--no-skills"; fi
  # shellcheck disable=SC2086  # an empty flag must expand to nothing
  exec "$WIKI_DIR/wiki" update --post-pull "$before" $skills_flag
}

# ── Entry point ──────────────────────────────────────────────────────
# Guard before dispatch: every subcommand except help/version touches vault
# state, so demand a vault. Help + version must work in a bare checkout.
case "${1:-}" in
  help|-h|--help|version|install-shortcut) ;;
  *) require_vault ;;
esac

# Bash keeps only bootstrap + the commands not yet ported. Every other
# subcommand is delegated to scripts/cli.py, which is the single source of
# truth for the command catalog (its routes and aliases included), the
# once-locked dashboard refresh and the argv-safe OAuth bootstrap. Bare `wiki`
# goes there too: cli.py opens the home screen when stdin and stdout are
# terminals and prints help otherwise, so CI, pipes, hooks and cron never block
# on input. An unknown command falls through to cli.py, which prints its own
# "unknown command" error.
case "${1:-}" in
  update)           shift; cmd_update "$@" ;;
  # Everything else is a Python-backed subcommand owned by the cli.py table
  # (unknown names error there). "$@" still carries the command name.
  *)                _dispatch_python "$@" ;;
esac
