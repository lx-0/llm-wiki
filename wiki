        "status")                       cmd_status ;;
        "run setup wizard")             cmd_setup ;;
        "edit config")                  config_cmd_edit ;;
        "hooks status")                 hooks_cmd_status ;;
        "install hooks")                hooks_cmd_install ;;
        "skills status")                skills_cmd_status ;;
        "update engine (git pull)")     cmd_update ;;
        "seed templates (audit)")       cmd_seed --check ;;
        "seed templates (apply)")       cmd_seed ;;
        "version")                      cmd_version ;;
        "back")                         return 0 ;;
      esac ;;
    *)
      err "unknown bucket: $bucket"
      return 1 ;;
  esac
}

home_render_status() {
  # Compose the one-liner from a status JSON object. Renders nothing if
  # all fields absent. Uses jq-extracted scalars.
  local status_json="$1"
  local articles ollama_ok last_compile
  articles="$(jq -r '.articles // empty' <<<"$status_json" 2>/dev/null)"
  ollama_ok="$(jq -r '.ollama_reachable // empty' <<<"$status_json" 2>/dev/null)"
  last_compile="$(jq -r '.last_compile_ago // empty' <<<"$status_json" 2>/dev/null)"
  local -a parts=()
  if [[ -n "$articles" ]]; then
    parts+=("${articles} article$([[ $articles == 1 ]] || echo s)")
  fi
  if [[ -n "$last_compile" ]]; then
    parts+=("last compile ${last_compile} ago")
  fi
  if [[ "$ollama_ok" == "true" ]]; then
    parts+=("ollama ${C_GREEN}✓${C_RESET}")
  elif [[ "$ollama_ok" == "false" ]]; then
    parts+=("ollama ${C_RED}✗${C_RESET}")
  fi
  (( ${#parts[@]} == 0 )) && return 0
  local line=""
  local sep=""
  for p in "${parts[@]}"; do
    line+="${sep}${p}"
    sep=" ${C_DIM}·${C_RESET} "
  done
  printf "  %s%s%s\n" "$C_DIM" "$line" "$C_RESET"
}

# Two-prompt helper for `/correct-add` (title + truth).
home_correct_add() {
  local t; t="$(ask "Title (one sentence)")"
  [[ -z "$t" ]] && { info "cancelled"; return 0; }
  local u; u="$(ask "Truth (one sentence)")"
  [[ -z "$u" ]] && { info "cancelled"; return 0; }
  cmd_correct add "$t" "$u"
}

# Flat command catalog used by the `/` fuzzy filter. One row per line:
# "command-name|short description|dispatcher". Dispatcher is a bash
# function (or `prompt:<label>:<cmd>` sentinel) the filter routes to.
# Hand-curated — explicit beats magic, and the list churns slowly.
# Cost markers: ($) = local LLM cheap, ($$) = Claude SDK, ($$$) = expensive.
_home_command_catalog() {
  cat <<'EOF'
compile|recompile changed sources ($$)|cmd_compile
compile-all|force-recompile every source ($$$)|cmd_compile --all
compile-file|compile one file ($$)|prompt:Path (vault-relative):cmd_compile --file
