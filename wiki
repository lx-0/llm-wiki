#!/usr/bin/env bash
# wiki — single entry-point CLI for the wiki/ system.
#
# The command catalog is NOT maintained here. `scripts/cli.py` owns the full
# table of subcommands (name, handler, banner, refresh-after, per-command help)
# and is the single source of truth — `wiki help` renders it and menu.py derives
# from it. This bash layer only does bootstrap (symlink resolution + vault guard
# + TTY detection) and the genuinely-bash commands (setup / hooks / skills /
# config / seed / update / menu / doctor / status / install-shortcut / version
# plus the bespoke dream + dream-entity argv routing). Every other subcommand is
# delegated to `scripts/cli.py`, which also owns the once-locked dashboard
# refresh and the OAuth bootstrap (`wiki auth <service> <account-id>`).

set -euo pipefail

# Resolve symlinks so `wiki` invoked via ~/.local/bin/wiki (created by
# `wiki install-shortcut`) still finds lib/* relative to the real script
# location, not relative to the symlink path. macOS `readlink -f` lives
# in coreutils (greadlink) and isn't guaranteed; use a portable Python
# fallback via the script's own dirname loop.
_resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  cd "$(dirname "$src")" && pwd
}
WIKI_DIR="$(_resolve_self)"
ROOT_DIR="$(cd "$WIKI_DIR/.." && pwd)"
export WIKI_DIR ROOT_DIR

# shellcheck source=lib/common.sh
source "$WIKI_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$WIKI_DIR/lib/ui.sh"
# shellcheck source=lib/agents.sh
source "$WIKI_DIR/lib/agents.sh"
# shellcheck source=lib/hooks.sh
source "$WIKI_DIR/lib/hooks.sh"
# shellcheck source=lib/skills.sh
source "$WIKI_DIR/lib/skills.sh"
# shellcheck source=lib/config.sh
source "$WIKI_DIR/lib/config.sh"
# shellcheck source=lib/seed.sh
source "$WIKI_DIR/lib/seed.sh"

require_cmd jq "needed to merge agent hook configs"
require_cmd uv "needed to run the python config helper"

# ── Vault guard ──────────────────────────────────────────────────────
# Engine refuses to run outside an Obsidian vault. Without this, a bare
# checkout of the engine repo gets treated as a vault by paths.py
# (WIKI_DIR=<repo>, ROOT_DIR=<parent>) and `wiki <foo>` scribbles
# logs/, state/, reports/, config.yaml into the engine source tree.
# Marker: `.obsidian/` at ROOT_DIR — the canonical user-facing vault signal.
require_vault() {
  if [[ ! -d "$ROOT_DIR/.obsidian" ]]; then
    >&2 echo "wiki: $ROOT_DIR is not an Obsidian vault (no .obsidian/ directory)."
    >&2 echo "    The engine only runs against real vaults — install it as <vault>/.wiki/"
    >&2 echo "    and invoke \`wiki\` from there."
    exit 1
  fi
}

# ── Subcommand dispatchers ───────────────────────────────────────────
cmd_status() {
  banner "wiki status"
  config_cmd_status
