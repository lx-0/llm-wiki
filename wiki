#!/usr/bin/env bash
# wiki — single entry-point CLI for the wiki/ system.
#
# Subcommands:
#   wiki                       interactive top-level menu
#   wiki setup                 first-time setup (config wizard + hooks install)
#   wiki status                full system status (config + hooks)
#   wiki config                interactive config editor
#   wiki config get KEY        print a config value (dot-notation)
#   wiki config set KEY VALUE  set a config value
#   wiki config wizard         re-run the setup wizard for config only
#   wiki hooks install         install hooks into selected agents
#   wiki hooks uninstall       remove wiki hooks
#   wiki hooks status          print install status table
#   wiki skills install        symlink engine skills into <vault>/.claude/skills/
#   wiki skills uninstall      remove engine-owned skill symlinks
#   wiki skills sync           install missing + prune stale (used by `wiki update`)
#   wiki skills status         per-skill linked/collision/missing table
#   wiki collect --list        list registered Collectors
#   wiki collect <name>        run one Collector (--dry-run | --incremental | --account ID)
#   wiki gmail-auth <id>       OAuth bootstrap for a Gmail account-id (one-time)
#   wiki update                git pull --ff-only the .wiki/ checkout (preserves config.yaml)
#   wiki seed                  re-seed missing vault templates (additive, safe)
#   wiki seed --force          overwrite existing vault templates with engine versions
#   wiki compile               run compile.py — process all changed sources into knowledge/
#   wiki compile --file PATH   compile a single source file
#   wiki flush                 capture current Claude Code context → daily/ (manual flush)
#   wiki lint                  run lint.py — structural + LLM contradiction checks
#   wiki lint --structural-only  cheap, no-LLM lint (used by piggyback)
#   wiki query "QUESTION"      ask the knowledge base via the configured model
#   wiki agent <id>            run an agentic task (Claude SDK driven by prompts/agent_<id>.md)
#   wiki agent --list          list registered agent tasks
#   wiki correct add "TITLE" "TRUTH" [--status S] [--term T ...]
#                              record a hard fact that overrides any source
#   wiki correct list          list all hard facts
#   wiki correct remove SLUG   delete a hard fact
#   wiki correct edit SLUG     open a hard fact in $EDITOR
#   wiki correct apply SLUG    propagate a fact across knowledge/, daily/, raw/ (agentic, $$$)
#   wiki review-wiki           per-article quality-score sweep (local LLM, free)
#   wiki version               print installed git revision
#   wiki help                  this message

set -euo pipefail

WIKI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$WIKI_DIR/.." && pwd)"
export WIKI_DIR ROOT_DIR

# shellcheck source=lib/common.sh
source "$WIKI_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
source "$WIKI_DIR/lib/ui.sh"
# shellcheck source=lib/agents.sh
source "$WIKI_DIR/lib/agents.sh"
# shellcheck source=lib/hooks.sh
source "$WIKI_DIR/lib/hooks.sh"
# shellcheck source=lib/skills.sh
source "$WIKI_DIR/lib/skills.sh"
# shellcheck source=lib/config.sh
source "$WIKI_DIR/lib/config.sh"
# shellcheck source=lib/seed.sh
source "$WIKI_DIR/lib/seed.sh"

require_cmd jq "needed to merge agent hook configs"
require_cmd uv "needed to run the python config helper"

# ── Subcommand dispatchers ───────────────────────────────────────────
cmd_status() {
  banner "wiki status"
  config_cmd_status
  echo
  hooks_status_table
}

help_config() {
  cat <<EOF
${C_BOLD}wiki config${C_RESET} — manage tunable parameters in .wiki/config.yaml

${C_BOLD}USAGE${C_RESET}
  wiki config                       interactive editor (browse sections, edit fields)
  wiki config get KEY               print one value
  wiki config set KEY VALUE         set + write back
  wiki config keys                  list all settable keys
  wiki config path                  print path to config.yaml
  wiki config wizard                re-run the 5-question setup wizard
  wiki config status                summary table + Ollama probe

${C_BOLD}KEYS${C_RESET} use dot-notation:
  models.compile_model              claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5
  models.ollama_url                 e.g. http://localhost:11434
  scheduling.compile_after_hour     0–23 (auto-compile trigger hour, local time)
  features.curiosity_loop           true|false
  features.vision_screenshots       true|false
  features.procmail_execution       true|false (off by default — kasserver-specific)
  piggybacks.<task>.enabled         e.g. piggybacks.scan_screenshots.enabled
  piggybacks.<task>.cooldown_hours  e.g. 24 (daily) or 168 (weekly)

${C_BOLD}EXAMPLES${C_RESET}
  wiki config get models.compile_model
  wiki config set models.compile_model claude-sonnet-4-6
  wiki config set piggybacks.scan_screenshots.enabled false
  wiki config keys | grep features

${C_DIM}Note: comments in config.yaml are dropped on programmatic writes (PyYAML round-trip).${C_RESET}
EOF
}

help_hooks() {
  cat <<EOF
${C_BOLD}wiki hooks${C_RESET} — install session hooks into AI agent configs

${C_BOLD}USAGE${C_RESET}
  wiki hooks install                interactive: pick agents + scope, merge hooks in
  wiki hooks uninstall              interactive: remove wiki-managed hooks
  wiki hooks status                 install table per agent / scope

${C_BOLD}TARGETS${C_RESET}
  claude   .claude/settings.json     (Claude Code)
  codex    .codex/hooks.json         (OpenAI Codex CLI 0.30+)
  gemini   .gemini/settings.json     (Google Gemini CLI)
  cursor   .cursor/hooks.json        (Cursor 1.7+)

${C_BOLD}SCOPE${C_RESET}
  user      ~/<.agent>/...           applies to all sessions
  project   <repo>/<.agent>/...      applies only when CWD is this repo

${C_BOLD}EVENT MAPPING${C_RESET} (auto, per agent)
                  claude         codex     gemini       cursor
  session-start   SessionStart   Start     SessionStart  —
  session-end     SessionEnd     Stop      SessionEnd    stop
  pre-compact     PreCompact     —         PreCompress   —

${C_BOLD}SAFETY${C_RESET}
  • Existing config files are merged via jq deep-merge — your other hooks stay.
  • Every write makes a .bak.YYYYMMDD-HHMMSS backup.
  • Uninstall only removes entries whose command contains '.wiki/hooks/'.

${C_BOLD}NOT SUPPORTED${C_RESET}
  pi         TypeScript-only hooks (~/.omp/agent/hooks/{pre,post}/*.ts)
  opencode   no native hooks yet (sst/opencode#5409)
EOF
}

help_setup() {
  cat <<EOF
${C_BOLD}wiki setup${C_RESET} — first-time setup

Walks the 5-question config wizard, then runs the hook installer.

${C_BOLD}WIZARD QUESTIONS${C_RESET}
  1. Ollama base URL    (probed for reachability)
  2. Compile model      (opus | sonnet | haiku)
  3. Auto-compile hour  (0–23, local time)
  4. Procmail execution (kasserver-specific, default off)
  5. Local-LLM features (curiosity loop + vision screenshots)

Press Enter on any question to keep the current value.
EOF
}

cmd_config() {
  case "${1:-}" in
    "")                       config_cmd_edit ;;
    -h|--help|help)           help_config ;;
    get)   shift; [[ $# -eq 1 ]] || die "usage: wiki config get KEY";  config_get "$1" ;;
    set)   shift; [[ $# -eq 2 ]] || die "usage: wiki config set KEY VALUE"; config_set "$1" "$2" ;;
    keys)                     config_keys ;;
    path)                     config_path ;;
    wizard)                   config_cmd_setup_wizard ;;
    status)                   config_cmd_status ;;
    *)                        err "unknown: wiki config $1"; help_config; exit 1 ;;
  esac
}

cmd_hooks() {
  case "${1:-}" in
    install|"")               hooks_cmd_install ;;
    uninstall)                hooks_cmd_uninstall ;;
    status)                   hooks_cmd_status ;;
    -h|--help|help)           help_hooks ;;
    *)                        err "unknown: wiki hooks $1"; help_hooks; exit 1 ;;
  esac
}

help_skills() {
  cat <<EOF
${C_BOLD}wiki skills${C_RESET} — wire engine skills into Claude Code

${C_BOLD}USAGE${C_RESET}
  wiki skills install               symlink missing engine skills into .claude/skills/
  wiki skills uninstall             remove engine-owned symlinks (foreign entries kept)
  wiki skills sync                  install missing + prune stale (run after wiki update)
  wiki skills status                per-skill linked / collision / missing table

${C_BOLD}NOTES${C_RESET}
  Source: $WIKI_DIR/skills/
  Target: $ROOT_DIR/.claude/skills/
  Only symlinks pointing at ../../.wiki/skills/<name> are managed.
  Foreign entries (your own skills, other tools) are never modified.
EOF
}

cmd_skills() {
  case "${1:-}" in
    install|"")               skills_cmd_install ;;
    uninstall)                skills_cmd_uninstall ;;
    sync)                     skills_cmd_sync ;;
    status)                   skills_cmd_status ;;
    -h|--help|help)           help_skills ;;
    *)                        err "unknown: wiki skills $1"; help_skills; exit 1 ;;
  esac
}

cmd_setup() {
  case "${1:-}" in
    -h|--help|help)           help_setup; return 0 ;;
  esac
  banner "wiki setup" "First-time setup: config wizard, then hook install."
  config_cmd_setup_wizard
  echo
  if confirm "Now install hooks into agent configs?" y; then
    hooks_cmd_install
  else
    info "Skipped hook install — run \`wiki hooks install\` later."
  fi
}

cmd_help() {
  # Print the leading comment block (everything up to the first blank line).
  awk '/^[^#]/ && !/^$/ { exit } /^#!/ { next } { sub(/^# ?/, ""); print }' "$0"
  cat <<EOF

${C_BOLD}DETAILED HELP${C_RESET}
  wiki setup --help
  wiki config --help
  wiki hooks --help
  wiki skills --help

${C_BOLD}DOCS${C_RESET}
  $WIKI_DIR/README.md
EOF
}

_run_script() {
  # Helper: run a script under the wiki venv. $1 = script name, rest = args.
  local script="$1"; shift
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/$script" "$@"
}

_refresh_dashboard_stats() {
  uv run --quiet --project "$WIKI_DIR" python "$WIKI_DIR/scripts/dashboard_stats.py" 2>/dev/null || true
}

cmd_compile() {
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki compile${C_RESET} — run the compiler against changed (or all) sources

${C_BOLD}USAGE${C_RESET}
  wiki compile                       compile only sources whose hash changed since last run
  wiki compile --all                 force-recompile every source in raw/ + daily/
  wiki compile --file PATH           compile a single file (relative to vault root)

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/compile.py\`. Runs Claude Agent SDK against your configured compile_model.
  LLM cost applies. Dashboard counts refresh automatically afterwards.
EOF
      return 0 ;;
  esac
  banner "wiki compile"
  _run_script compile.py "$@"
  local rc=$?
  _refresh_dashboard_stats
  return $rc
}

cmd_flush() {
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki flush${C_RESET} — capture the current Claude Code session context to daily/

${C_BOLD}USAGE${C_RESET}
  wiki flush                         manually trigger a flush (normally automatic via hooks)

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/flush.py\`. Reads recent session transcript, extracts a
  daily-log entry, appends to \`daily/YYYY-MM-DD.md\`. After 18:00 (or
  whatever \`scheduling.compile_after_hour\` is set to), triggers compile +
  piggyback tasks. Dashboard counts refresh automatically afterwards.
EOF
      return 0 ;;
  esac
  banner "wiki flush"
  _run_script flush.py "$@"
  local rc=$?
  _refresh_dashboard_stats
  return $rc
}

cmd_lint() {
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki lint${C_RESET} — health-check the knowledge base

${C_BOLD}USAGE${C_RESET}
  wiki lint                          full: structural + LLM contradiction check (\$ cost)
  wiki lint --structural-only        cheap structural checks only (no LLM)

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/lint.py\`. Structural checks: broken_links, orphan_pages,
  orphan_sources, stale_articles, missing_backlinks, article_type, sparse_articles.
  Report saved to \`.wiki/reports/lint-YYYY-MM-DD.md\`. Dashboard counts refresh.
EOF
      return 0 ;;
  esac
  banner "wiki lint"
  _run_script lint.py "$@"
  local rc=$?
  _refresh_dashboard_stats
  return $rc
}

cmd_query() {
  case "${1:-}" in
    ""|-h|--help|help)
      cat <<EOF
${C_BOLD}wiki query${C_RESET} — ask the knowledge base in natural language

${C_BOLD}USAGE${C_RESET}
  wiki query "WHAT did we decide about X?"

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/query.py\`. Reads \`knowledge/index.md\`, picks the
  relevant articles, answers via the configured query model. LLM cost applies.
EOF
      return 0 ;;
  esac
  banner "wiki query"
  _run_script query.py "$@"
}

cmd_agent() {
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki agent${C_RESET} — run an agentic task

${C_BOLD}USAGE${C_RESET}
  wiki agent <id>                          run task defined in prompts/agent_<id>.md
  wiki agent <id> --dry-run                resolve + print spec without spawning
  wiki agent <id> --var key=value          substitute \${key} in the prompt body
  wiki agent --list                        list registered tasks

${C_BOLD}EXAMPLES${C_RESET}
  wiki agent summarize-day                 # cheap Haiku run on today's daily/
  wiki agent summarize-day --dry-run
  wiki agent --list

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/agent_task.py\`. Spawns Claude Agent SDK with the model,
  allowed_tools, permission_mode, max_turns, and cwd declared in the task's
  frontmatter. Result text logged to \`.wiki/logs/agent-<id>-<ts>.log\`.
  On success the task's frontmatter gets \`last_run: <iso-ts>\` written back.
EOF
      return 0 ;;
  esac
  banner "wiki agent"
  _run_script agent_task.py "$@"
}

cmd_correct() {
  case "${1:-}" in
    ""|-h|--help|help)
      cat <<EOF
${C_BOLD}wiki correct${C_RESET} — record hard facts that override LLM-compiled wiki content

${C_BOLD}USAGE${C_RESET}
  wiki correct add "TITLE" "TRUTH"           add a hard fact (default --status=negation)
      [--status negation|disambiguation|clarification]
      [--term "exact substring" ...]         lint will grep these across knowledge/
      [--slug SLUG]                          override auto-derived slug
      [--force]                              overwrite if it already exists
  wiki correct list                          list all hard facts
  wiki correct remove SLUG                   delete a hard fact (.bak.<ts> kept)
  wiki correct edit SLUG                     open in \$EDITOR (.bak.<ts> kept first)
  wiki correct apply SLUG [--dry-run]        agentic propagation across vault (\$\$\$ — Claude SDK)
  wiki correct path SLUG                     print absolute path

${C_BOLD}EXAMPLES${C_RESET}
  wiki correct add "Senkrechtstarter award (NOT won)" \\
      "We did NOT win the Senkrechtstarter award. Strike any article asserting otherwise." \\
      --status negation \\
      --term "senkrechtstarter award" --term "won the senkrechtstarter"

  wiki correct add "Township project = Fleet" \\
      "The active 'township' project is named Fleet. There is also an older project under the township-* namespace — never conflate them." \\
      --status disambiguation

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/correct.py\`. Facts live in \`knowledge/facts/<slug>.md\` with
  \`type: fact\` frontmatter. Compile + query inject them as a Hard-facts block at
  highest authority. Lint surfaces violations of any \`negation_terms\`.
EOF
      [[ "${1:-}" == "" ]] && return 1 || return 0
      ;;
  esac
  if [[ "${1:-}" == "apply" ]]; then
    shift
    banner "wiki correct apply" "Agentic propagation — Claude Agent SDK over vault root."
    _run_script correct_apply.py "$@"
    local rc=$?
    _refresh_dashboard_stats
    return $rc
  fi
  banner "wiki correct"
  _run_script correct.py "$@"
  local rc=$?
  _refresh_dashboard_stats
  return $rc
}

cmd_review_wiki() {
  case "${1:-}" in
    -h|--help|help)
      cat <<EOF
${C_BOLD}wiki review-wiki${C_RESET} — per-article quality scores via local LLM

${C_BOLD}USAGE${C_RESET}
  wiki review-wiki                   sweep every article, score each one

${C_BOLD}NOTES${C_RESET}
  Wraps \`scripts/review-wiki.py\`. Uses the local Ollama model — \$0 cost.
  Output goes to \`.wiki/reports/review-YYYY-MM-DD.md\`. Runs as weekly piggyback
  by default; this command is for ad-hoc manual runs.
EOF
      return 0 ;;
  esac
  banner "wiki review-wiki"
  _run_script review-wiki.py "$@"
}


cmd_seed() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)                  force=1; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki seed${C_RESET} — re-apply engine templates to the vault root

${C_BOLD}USAGE${C_RESET}
  wiki seed                     additive: add missing files, merge community-plugins
  wiki seed --force             overwrite existing vault templates with engine versions

${C_BOLD}WHAT IT DOES${C_RESET}
  - Seeds missing files: AGENTS.md, dashboard.md
  - Seeds missing .obsidian/*.json + .obsidian/plugins/<name>/data.json
  - Merges community-plugins.json (additive — adds engine plugins, never drops yours)
  - Cache files (_dashboard-*.md) are NOT seeded — first \`wiki flush\` writes them.

${C_BOLD}SAFETY${C_RESET}
  Default mode never overwrites your edits. Run after \`wiki update\` whenever
  the engine has new templates. Use --force only if you want to discard your
  customisations of dashboard.md / AGENTS.md and pick up the latest engine version.
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  banner "wiki seed" "$( (( force == 1 )) && echo 'overwrite mode' || echo 'additive mode' )"
  seed_vault_templates "$ROOT_DIR" "$WIKI_DIR" "$force"
}


cmd_update() {
  local sync_skills=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-skills)              sync_skills=0; shift ;;
      -h|--help|help)
        cat <<EOF
${C_BOLD}wiki update${C_RESET} — git pull --ff-only the .wiki/ checkout

${C_BOLD}USAGE${C_RESET}
  wiki update                   pull + sync skill symlinks
  wiki update --no-skills       pull only, skip skill sync
EOF
        return 0 ;;
      *)                        err "unknown flag: $1"; exit 1 ;;
    esac
  done
  if [[ ! -d "$WIKI_DIR/.git" ]]; then
    die "Not a git checkout — wiki/ wasn't installed via install.sh. Manual update required."
  fi
  local before; before="$(git -C "$WIKI_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  info "Pulling latest into $WIKI_DIR …"
  if ! git -C "$WIKI_DIR" pull --ff-only; then
    die "git pull failed (non-fast-forward or network). Resolve manually in $WIKI_DIR."
  fi
  local after; after="$(git -C "$WIKI_DIR" rev-parse --short HEAD)"
  if [[ "$before" == "$after" ]]; then
    ok "Already up to date ($before)"
  else
    ok "Updated $before → $after"
    info "If hook payloads or config schema changed, you may want to re-run:"
    info "  wiki hooks install      ${C_DIM}# to refresh agent hook configs${C_RESET}"
  fi
  if (( sync_skills == 1 )); then
    skills_cmd_sync
  else
    info "skills: skipped (--no-skills)"
  fi
}

