#!/usr/bin/env bash
# wiki — single entry-point CLI for the wiki/ system.
#
# Subcommands:
#   wiki                       interactive home screen (TTY) — execs
#                              `scripts/menu.py` (prompt_toolkit-driven). Status
#                              one-liner, context-sensitive suggestions, quick
#                              actions, category browse, `/<substring>` fuzzy
#                              filter. Non-TTY callers fall back to this help.
#   wiki menu                  same home screen, forced regardless of TTY.
#   wiki menu --json           emit suggestions + status JSON, exit (for agents)
#   wiki doctor                vault-health audit (config + connectivity + pipeline)
#   wiki doctor --quick        skip TCP + subprocess probes (~50ms; for hooks)
#   wiki doctor --json         machine-readable health output (for agents)
#   wiki install-shortcut      symlink ~/.local/bin/wiki → this vault (so `wiki` works from any cwd)
#   wiki setup                 first-time setup (config wizard + hooks install)
#   wiki status                full system status (config + hooks)
#   wiki config                interactive config editor
#   wiki config get KEY        print a config value (dot-notation)
#   wiki config set KEY VALUE  set a config value
#   wiki config wizard         re-run the setup wizard for config only
#   wiki hooks install         install hooks into selected agents
#   wiki hooks uninstall       remove wiki hooks
#   wiki hooks status          print install status table
#   wiki skills install        symlink engine skills into <vault>/.claude/skills/
#   wiki skills install --global  also link global skills into ~/.claude/skills/
#                                 + register the vault (sets skills.global_install)
#   wiki skills uninstall      remove engine-owned skill symlinks
#   wiki skills uninstall --global  also remove global links + deregister vault
#   wiki skills sync           install missing + prune stale (used by `wiki update`)
#   wiki skills status         per-skill linked/collision/missing table + global state
#   wiki collect --list        list registered Collectors
#   wiki collect <name>        run one Collector (--dry-run | --incremental | --account ID)
#   wiki gmail-auth <id>       OAuth bootstrap for a Gmail account-id (one-time)
#   wiki gmeet-auth <id>       OAuth bootstrap for Google Meet transcripts (one-time)
#   wiki calendar-auth <id>    OAuth bootstrap for Google Calendar events (one-time)
#   wiki update                git pull --ff-only the .wiki/ checkout (preserves config.yaml)
#   wiki seed                  re-seed missing vault templates (additive, safe)
#   wiki seed --force          overwrite existing vault templates with engine versions
#   wiki compile               run compile.py — process all changed sources into knowledge/
#   wiki compile --file PATH   compile a single source file
#   wiki dream-entity SLUG     re-synthesize ONE entity page (people/projects/areas) — M014
#   wiki dream                 sweep all entities (oldest-overdue first, respects cooldown)
#   wiki flush                 capture current Claude Code context → daily/ (manual flush)
#   wiki lint                  run lint.py — structural + LLM contradiction checks
#   wiki lint --structural-only  cheap, no-LLM lint (used by piggyback)
#   wiki links                 broken-wikilink report (media/placeholder/dangling)
#   wiki links --fix           interactively rewrite high-confidence dangling refs
#   wiki query "QUESTION"      ask the knowledge base via the configured model
#   wiki query "Q" --brief     5-10 line bullet answer (cheapest)
#   wiki query "Q" --file-back full answer, persisted as knowledge/qa/<slug>.md
#   wiki agent <id>            run an agentic task (Claude SDK driven by prompts/agents/<id>.md)
#   wiki agent --list          list registered agent tasks
#   wiki correct add "TITLE" "TRUTH" [--status S] [--term T ...]
#                              record a hard fact that overrides any source
#   wiki correct list          list all hard facts
#   wiki correct remove SLUG   delete a hard fact
#   wiki correct edit SLUG     open a hard fact in $EDITOR
#   wiki correct apply SLUG    propagate a fact across knowledge/, daily/, raw/ (agentic, $$$)
#   wiki take add HOLDER "BELIEF" --source PATH [--confidence low|medium|high]
#                              record a third-party belief (M011 takes substrate)
#   wiki take list             list all takes files
#   wiki take show SLUG        show all takes for one holder
#   wiki take remove SLUG --line N | --all   remove a take line or the whole file
#   wiki pin <article>         pin an article to a Map-of-Content (no LLM, idempotent)
#   wiki pin <article> --section "Name" --moc people --summary "X"
#   wiki review-wiki           per-article quality-score sweep (local LLM, free)
#   wiki process-inbox [flags] classify files in <vault>/inbox/ via Ollama, route to raw/
#   wiki ingest-html PATH-OR-URL [--mode content|visual|both]
#                              convert HTML into raw/articles/ (and/or raw/notes/ visual)
#   wiki ingest-youtube --url URL [--tier 0|1|2] [--limit N] [--dry-run]
#   wiki ingest-youtube --inbox PATH [--tier 0|1|2] [--limit N] [--dry-run]
#                              ingest YouTube videos / playlists into raw/notes/youtube/
#   wiki curiosity [--walk|--list|--run-oldest|--run SLUG|--run-all|--clear-done]
#                              walk pending requests (default) or run them in bulk
#   wiki suggestions [--list|--review ID|--approve ID N|--reject ID N|--dry-run]
#                              review + execute YAML optimization suggestions
#   wiki version               print installed git revision
#   wiki help                  this message

set -euo pipefail

# Resolve symlinks so `wiki` invoked via ~/.local/bin/wiki (created by
# `wiki install-shortcut`) still finds lib/* relative to the real script
# location, not relative to the symlink path. macOS `readlink -f` lives
# in coreutils (greadlink) and isn't guaranteed; use a portable Python
# fallback via the script's own dirname loop.
_resolve_self() {
  local src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    local target; target="$(readlink "$src")"
    case "$target" in
      /*) src="$target" ;;
      *)  src="$(cd "$(dirname "$src")" && pwd)/$target" ;;
    esac
  done
  cd "$(dirname "$src")" && pwd
}
WIKI_DIR="$(_resolve_self)"
ROOT_DIR="$(cd "$WIKI_DIR/.." && pwd)"
export WIKI_DIR ROOT_DIR

# shellcheck source=lib/common.sh
source "$WIKI_DIR/lib/common.sh"
# shellcheck source=lib/ui.sh
