{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd '/srv/vaults/notes/.wiki' && uv run python hooks/session-start.py",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd '/srv/vaults/notes/.wiki' && uv run python hooks/session-end.py",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd '/srv/vaults/notes/.wiki' && uv run python hooks/pre-compact.py",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
